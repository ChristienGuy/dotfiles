{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/enforce-gh-stack.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-comment-slop.py",
            "timeout": 10,
            "statusMessage": "Checking comment discipline"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/christien.guy/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "ralph-loop@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "figma@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": false,
    "linear@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "sentry@claude-plugins-official": false,
    "github@claude-plugins-official": false,
    "notion@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": false,
    "paddle-shared@paddle-claude-plugin-marketplace": true,
    "honeycomb@honeycomb-plugins": false,
    "amplitude@claude-plugins-official": true,
    "paddle-frontend@paddle-claude-plugin-marketplace": true,
    "paddle-go-backend@paddle-claude-plugin-marketplace": true,
    "paper-desktop@paper": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "paddle-claude-plugin-marketplace": {
      "source": {
        "source": "github",
        "repo": "PaddleHQ/paddle-claude-plugin-marketplace"
      },
      "autoUpdate": true
    },
    "paper": {
      "source": {
        "source": "github",
        "repo": "paper-design/agent-plugins"
      }
    }
  },
  "outputStyle": "STE",
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
